{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "declaration": false,
    "sourceMap": false,
    "composite": false,
    "rootDir": "./",
    "outDir": "./",
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["./analysis/**/*.ts", "./*.ts"],
  "exclude": ["./*.spec.ts"]
}
