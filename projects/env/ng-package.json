{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/env",
  "allowedNonPeerDependencies": ["jsonc-parser"],
  "assets": [
    "./schematics/collection.json",
    {
      "glob": "**/*.cjs",
      "input": "./schematics",
      "output": "./schematics"
    },
    {
      "glob": "**/*.json",
      "input": "./schematics/schemas",
      "output": "./schematics/schemas"
    },
    "./LICENSE",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
