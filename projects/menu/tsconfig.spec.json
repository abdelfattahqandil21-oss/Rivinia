/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "../../out-tsc/spec",
    /*
     * `node` is required by the CSS spec, which reads the component stylesheet
     * from disk: a `@supports` prelude no engine can parse is dropped silently,
     * so it is checked with `CSS.supports` instead of a browser.
     */
    "types": ["vitest/globals", "node"]
  },
  /*
   * Unit tests live under `unit-tests/menu`, outside the publishable package.
   * The test target's `include` (see angular.json) reaches them.
   */
  "include": ["src/**/*.d.ts", "../../unit-tests/menu/*.d.ts", "../../unit-tests/menu/*.spec.ts"]
}
